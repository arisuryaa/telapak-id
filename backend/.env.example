DATABASE_URL=mysql+pymysql://root:@localhost:3306/telapak_id

# ROI box width relative to palm width: 1.0 = journal box (a square), 1.3 = wider box.
# Above 1.0 the box also rises toward the finger-base line but never goes past the wrist.
# Codes from different sizes are not compared; re-register after changing this.
ROI_SKALA=1.0

# How the palm is turned into a pattern: canny (edges with direction) or gabor (the original 6-filter code).
# Hands enrolled with the other method are kept but not used; register again, or switch back.
METODE=canny
